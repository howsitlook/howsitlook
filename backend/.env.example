# FastAPI Configuration
APP_NAME="Fashion Virtual Try-On API"
APP_VERSION="1.0.0"
DEBUG=True

# Database
DATABASE_URL="sqlite:///./fashion_app.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost/dbname"

# JWT Security
SECRET_KEY="your-super-secret-key-change-in-production-please-use-a-strong-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Paths
AVATAR_UPLOAD_DIR="./static/avatars"
INPUT_DIR="./static/inputs"
OUTPUT_DIR="./static/outputs"

# ML Model Settings
USE_GPU=False
MODEL_DEVICE="cpu"  # Change to "cuda" if GPU available

# AI Model Selection
VTON_MODEL_NAME="hr-vton"  # Options: hr-vton, cp-vton
POSE_TRANSFER_MODEL="pg2"  # Options: pg2, hr-vton-pose
RECOMMENDATION_TOP_K=10

# CORS Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]
